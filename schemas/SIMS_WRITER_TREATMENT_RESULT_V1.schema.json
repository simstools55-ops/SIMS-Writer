{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIMS Writer Treatment Result V1 - SBM Compact Transport",
  "type": "object",
  "required": [
    "format",
    "contract_version",
    "case_id",
    "article_id",
    "treatment_status",
    "referral_compliance",
    "publication_result"
  ],
  "properties": {
    "format": {
      "const": "SIMS_WRITER_TREATMENT_RESULT_V1"
    },
    "contract_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string"
    },
    "article_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "treatment_status": {
      "type": "string"
    },
    "referral_compliance": {
      "type": "object"
    },
    "performed_changes": {
      "type": "array"
    },
    "publication_result": {
      "type": "object"
    },
    "recommended_review_days": {
      "type": [
        "integer",
        "null"
      ]
    },
    "return_to": {
      "const": "SIMS_BLOG_MANAGER"
    }
  }
}
