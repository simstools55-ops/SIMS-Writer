{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims-writer.local/schemas/SIMS_WRITER_INTERNAL_AUDIT_V1.schema.json",
  "title": "SIMS Writer Internal Audit Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "analysis",
    "qa",
    "editorial_decisions"
  ],
  "properties": {
    "record_type": {
      "const": "SIMS_WRITER_INTERNAL_AUDIT_V1"
    },
    "analysis": {
      "type": "object"
    },
    "qa": {
      "type": "object"
    },
    "editorial_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_ok_count",
        "user_decision_count",
        "internal_reject_count",
        "internal_rejected_changes"
      ],
      "properties": {
        "public_ok_count": {
          "type": "integer",
          "minimum": 0
        },
        "user_decision_count": {
          "type": "integer",
          "minimum": 0
        },
        "internal_reject_count": {
          "type": "integer",
          "minimum": 0
        },
        "internal_rejected_changes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "serp_evidence_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "usable_result_count",
        "blocked_change_types",
        "allowed_non_serp_changes"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "unavailable"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "usable_result_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "blocked_change_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_non_serp_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_layer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "evidence_matrix": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "contamination_findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
