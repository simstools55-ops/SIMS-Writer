{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims-writer.local/schemas/SIMS_FEEDBACK_V2.schema.json",
  "title": "SIMS Feedback V2 Contract 4.2 - v2.0.1 Hotfix Editorial Delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "contract_version",
    "article_id",
    "article_url",
    "publication_result"
  ],
  "properties": {
    "format": {
      "const": "SIMS_FEEDBACK_V2"
    },
    "contract_version": {
      "const": "4.2"
    },
    "site_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "article_url": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_user_decision_changes",
        "publishable_public_ok_changes",
        "change_summary",
        "public_ok_changes",
        "user_decision_changes"
      ],
      "properties": {
        "publishable_public_ok_changes": {
          "type": "boolean"
        },
        "has_user_decision_changes": {
          "type": "boolean"
        },
        "change_summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_ok_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicOkChange"
          }
        },
        "user_decision_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/userDecisionChange"
          }
        },
        "serp_gap_report": {
          "$ref": "#/$defs/serpGapReport"
        }
      }
    },
    "recommended_review_days": {
      "type": [
        "integer",
        "null"
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis_extensions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "temporal_analysis": {
          "type": "object",
          "additionalProperties": true
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "ANNOUNCED",
            "SCHEDULED",
            "ACTIVE",
            "COMPLETED",
            "EXPIRING",
            "EXPIRED",
            "ARCHIVED",
            "UNKNOWN"
          ]
        },
        "knowledge_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "patterns_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string"
        },
        "review_summary": {
          "type": "object",
          "additionalProperties": true
        },
        "serp_findings": {
          "type": "object",
          "additionalProperties": true
        },
        "coverage_summary": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "$defs": {
    "publicOkChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "component_label",
        "before",
        "after",
        "implementation_instruction"
      ],
      "properties": {
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "component_label": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "implementation_instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "userDecisionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "component_label",
        "before",
        "after",
        "decision_reason",
        "benefit_if_adopted",
        "impact_if_not_adopted",
        "confirmation_point",
        "decision_trace"
      ],
      "properties": {
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "component_label": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "decision_reason": {
          "type": "string",
          "minLength": 1
        },
        "benefit_if_adopted": {
          "type": "string",
          "minLength": 1
        },
        "impact_if_not_adopted": {
          "type": "string",
          "minLength": 1
        },
        "confirmation_point": {
          "type": "string",
          "minLength": 1
        },
        "decision_trace": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serpGapItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "article_state",
        "action",
        "importance",
        "importance_label"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "article_state": {
          "enum": [
            "covered",
            "weak",
            "missing",
            "strength",
            "not_adopted"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "competitor_coverage": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "importance_label": {
          "enum": [
            "★☆☆☆☆",
            "★★☆☆☆",
            "★★★☆☆",
            "★★★★☆",
            "★★★★★"
          ]
        },
        "observed_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "compared_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "serpGapReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "comparison_scope",
        "strengths",
        "gaps",
        "applied_topics",
        "not_adopted_topics",
        "decision_summary",
        "compared_pages",
        "decision_trace"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "comparison_scope": {
          "type": "string",
          "minLength": 1
        },
        "strengths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serpGapItem"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serpGapItem"
          }
        },
        "applied_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "not_adopted_topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_summary": {
          "type": "string",
          "minLength": 1
        },
        "compared_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "decision_trace": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
