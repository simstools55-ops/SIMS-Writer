{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sims-writer.local/schemas/SIMS_FEEDBACK_V2.schema.json",
  "title": "SIMS Feedback V2 Contract 3.0 - User-Centered Editorial Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "contract_version",
    "article_id",
    "article_url",
    "publication_result",
    "information"
  ],
  "properties": {
    "format": {
      "const": "SIMS_FEEDBACK_V2"
    },
    "contract_version": {
      "const": "3.0"
    },
    "site_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "article_url": {
      "type": "string"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_summary",
        "public_ok_changes",
        "user_decision_changes"
      ],
      "properties": {
        "change_summary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_ok_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/publicOkChange"
          }
        },
        "user_decision_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/userDecisionChange"
          }
        }
      }
    },
    "recommended_review_days": {
      "type": [
        "integer",
        "null"
      ]
    },
    "information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "baseChange": {
      "type": "object",
      "required": [
        "component",
        "component_label",
        "before",
        "after"
      ],
      "properties": {
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "component_label": {
          "type": "string",
          "minLength": 1
        },
        "before": {
          "type": [
            "string",
            "null"
          ]
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "publicOkChange": {
      "allOf": [
        {
          "$ref": "#/$defs/baseChange"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "component_label",
            "before",
            "after",
            "implementation_instruction"
          ],
          "properties": {
            "component": {
              "type": [
                "string",
                "null"
              ]
            },
            "component_label": {
              "type": "string",
              "minLength": 1
            },
            "before": {
              "type": [
                "string",
                "null"
              ]
            },
            "after": {
              "type": "string",
              "minLength": 1
            },
            "implementation_instruction": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "userDecisionChange": {
      "allOf": [
        {
          "$ref": "#/$defs/baseChange"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "component_label",
            "before",
            "after",
            "decision_reason",
            "benefit_if_adopted",
            "impact_if_not_adopted",
            "confirmation_point"
          ],
          "properties": {
            "component": {
              "type": [
                "string",
                "null"
              ]
            },
            "component_label": {
              "type": "string",
              "minLength": 1
            },
            "before": {
              "type": [
                "string",
                "null"
              ]
            },
            "after": {
              "type": "string",
              "minLength": 1
            },
            "decision_reason": {
              "type": "string",
              "minLength": 1
            },
            "benefit_if_adopted": {
              "type": "string",
              "minLength": 1
            },
            "impact_if_not_adopted": {
              "type": "string",
              "minLength": 1
            },
            "confirmation_point": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
