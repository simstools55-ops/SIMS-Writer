{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIMS Writer Treatment Result V1",
  "type": "object",
  "required": [
    "format",
    "contract_version",
    "case_id",
    "article_id",
    "site_id",
    "completed_at",
    "treatment_status",
    "referral_compliance",
    "performed_changes",
    "publication_result",
    "recommended_review_days",
    "return_to"
  ],
  "properties": {
    "format": {
      "const": "SIMS_WRITER_TREATMENT_RESULT_V1"
    },
    "contract_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "completed_at": {
      "type": "string"
    },
    "treatment_status": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "USER_DECISION_REQUIRED",
        "BLOCKED",
        "FAILED"
      ]
    },
    "referral_compliance": {
      "type": "object",
      "required": [
        "compliant",
        "performed_scope",
        "blocked_scope_touched",
        "scope_violations"
      ]
    },
    "performed_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "not_performed_changes": {
      "type": "array"
    },
    "additional_findings": {
      "type": "array"
    },
    "publication_result": {
      "type": "object",
      "required": [
        "status"
      ]
    },
    "recommended_review_days": {
      "type": "integer",
      "minimum": 0
    },
    "return_to": {
      "const": "SIMS_BLOG_MANAGER"
    },
    "knowledge_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "scope",
          "knowledge_type",
          "statement",
          "confidence",
          "source_product",
          "source_type"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "OWNER",
              "SITE",
              "CROSS_SITE"
            ]
          },
          "site_id": {
            "type": "string"
          },
          "knowledge_type": {
            "type": "string"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": [
              "string",
              "number"
            ]
          },
          "source_product": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confirmation_event_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
