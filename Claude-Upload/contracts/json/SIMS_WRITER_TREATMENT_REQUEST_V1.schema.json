{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIMS Writer Treatment Request V1",
  "type": "object",
  "required": [
    "format",
    "contract_version",
    "case_id",
    "article_id",
    "site_id",
    "request_mode",
    "doctor_referral",
    "workflow",
    "return_contract"
  ],
  "properties": {
    "format": {
      "const": "SIMS_WRITER_TREATMENT_REQUEST_V1"
    },
    "contract_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "request_mode": {
      "const": "DOCTOR_REFERRAL_TREATMENT"
    },
    "doctor_referral": {
      "type": "object",
      "required": [
        "allowed_scope",
        "blocked_scope"
      ],
      "properties": {
        "diagnosis_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "treatment_level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "objective": {
          "type": "string"
        },
        "allowed_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "blocked_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": [
        "locked",
        "treatment_allowed"
      ],
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "treatment_allowed": {
          "type": "boolean"
        }
      }
    },
    "evidence_package": {
      "type": "object"
    },
    "return_contract": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
